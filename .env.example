# Attention Lab — local environment settings.
# Copy to .env at the repo root. No real secrets are committed to this
# repository, and none are invented for you: every value below is either a
# local-only development default or a placeholder you must supply yourself.
#
# `cp .env.example .env` at the repo root is the only copy needed: the API
# scripts (via --env-file-if-exists), drizzle.config.ts and the Vitest test
# setup all read this same `<repo root>/.env` file directly. No per-package
# copies exist or are read.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Matches the local docker container started by `npm run db:up`.
# Port 55432 is used deliberately so it cannot collide with a system Postgres
# already listening on 5432.
DATABASE_URL=postgres://attention:devpassword@localhost:55432/attention_lab

# Used only by the test suite (`npm run test:api`, `npm run db:test`). It MUST
# name a different database from DATABASE_URL — the test suite truncates its
# tables between test files, and running that against your dev database would
# destroy your working data.
DATABASE_URL_TEST=postgres://attention:devpassword@localhost:55432/attention_lab_test

# ---------------------------------------------------------------------------
# API server (required)
# ---------------------------------------------------------------------------
API_PORT=8787
API_HOST=127.0.0.1

# Web origin permitted to call the API with credentials.
WEB_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Identity mode (required)
# ---------------------------------------------------------------------------
# The accepted values are exactly local-demo and real. A missing or
# unrecognized value refuses to boot, naming the setting — there is no
# fallback.
#
# local-demo : NO real authentication. A single fixed local principal is used.
#              Every record written is stamped realm='demo' and the UI shows a
#              permanent banner. This mode additionally REQUIRES API_HOST to
#              be one of 127.0.0.1, localhost or ::1 — it refuses to boot on
#              any other interface. Never enter real personal data.
# real        : Requires a configured OAuth provider (see below). Not yet
#              implemented — see LIMITATIONS.md. Until it is, `real` refuses
#              to boot, listing whichever of the four settings below are
#              still missing, rather than silently falling back to
#              local-demo.
IDENTITY_MODE=local-demo

# ---------------------------------------------------------------------------
# Real authentication (placeholders — required before ANY real personal record)
# ---------------------------------------------------------------------------
# Registering an OAuth client, its callback URLs and an invitation allowlist is
# a prerequisite for IDENTITY_MODE=real. Nothing here has been created for you.
# AUTH_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AUTH_INVITE_ALLOWLIST=

# ---------------------------------------------------------------------------
# Static web serving (D37, optional)
# ---------------------------------------------------------------------------
# When set, the API serves this directory as the built web app, with an SPA
# fallback for every path that does not start with /api. Leave this unset in
# day-to-day development, where Vite serves the web app separately on its own
# port; it is set automatically by the Playwright acceptance project after
# `npm run build`.
# WEB_DIST_DIR=apps/web/dist
