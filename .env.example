# Attention Lab — local environment settings.
# Copy to .env and fill in. No real secrets are committed to this repository,
# and none are invented for you: every value below is either a local-only
# development default or a placeholder you must supply yourself.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Matches the local docker container started by `npm run db:up`.
# Port 55432 is used deliberately so it cannot collide with a system Postgres
# already listening on 5432.
DATABASE_URL=postgres://attention:devpassword@localhost:55432/attention_lab

# ---------------------------------------------------------------------------
# API server (required)
# ---------------------------------------------------------------------------
API_PORT=8787
API_HOST=127.0.0.1

# Web origin permitted to call the API with credentials.
WEB_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Identity mode (required)
# ---------------------------------------------------------------------------
# local-demo : NO real authentication. A single fixed local principal is used.
#              Every record written is stamped realm='demo' and the UI shows a
#              permanent banner. Bind to 127.0.0.1 only. Never expose this mode
#              on a network interface and never enter real personal data.
# real        : Requires a configured OAuth provider (see below). Not yet
#              implemented — see LIMITATIONS.md. Until it is, `real` refuses to
#              boot rather than silently falling back to local-demo.
IDENTITY_MODE=local-demo

# ---------------------------------------------------------------------------
# Real authentication (placeholders — required before ANY real personal record)
# ---------------------------------------------------------------------------
# Registering an OAuth client, its callback URLs and an invitation allowlist is
# a prerequisite for IDENTITY_MODE=real. Nothing here has been created for you.
# AUTH_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AUTH_INVITE_ALLOWLIST=
