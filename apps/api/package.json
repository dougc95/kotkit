{
  "name": "@attention-lab/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:test": "tsx --env-file-if-exists=../../.env scripts/bootstrap-test-db.ts",
    "load:report": "tsx --env-file-if-exists=../../.env scripts/report-load.ts",
    "migrations:check": "drizzle-kit check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@attention-lab/shared": "^0.1.0",
    "@fastify/static": "10.1.3",
    "@fastify/type-provider-typebox": "6.1.0",
    "@sinclair/typebox": "0.34.52",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.3",
    "fastify-plugin": "5.1.0",
    "pino": "10.3.1",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13"
  }
}
